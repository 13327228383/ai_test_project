# ═══════════════════════════════════════════════════════════════
# E2E 智能测试引擎 — 环境变量模板
# 复制此文件为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════════

# ── MySQL 存储配置 ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=ai_test_engine

# ── Figma API ──
FIGMA_API_KEY=your_figma_api_key_here

# ── Confluence ──
CONFLUENCE_PASSWORD=your_confluence_password_here

# ── YApi 接口文档 ──
YAPI_PASSWORD=your_yapi_password_here

# ── 目标系统 ──
TARGET_PASSWORD=your_target_system_password_here

# ── 目标数据库 ──
TARGET_DB_PASSWORD=your_target_db_password_here

# ── Flask ──
# Flask session 签名密钥（请自行生成随机值：python -c "import secrets;print(secrets.token_urlsafe(32))"）
FLASK_SECRET_KEY=your_flask_secret_key_here
# Fernet 密码加密密钥（留空则首次启动自动生成并存入 MySQL，容器部署时设置）
ENCRYPTION_KEY_V2=
FLASK_ENV=production

# ── RAG 语义引擎（自动检测，无需手动配置） ──
# sentence-transformers 已安装 → 384维语义向量（高精度语义匹配）
# sentence-transformers 未安装 → 字符级 ngram 向量（零依赖，精度略低）
# 强制回退 ngram（低内存环境 / 不想装模型）：
# RAG_DISABLE_SENTENCE_TRANSFORMERS=1

# ── 审核闸门（Step2 需求拆解完成后是否暂停等待人工审核） ──
# 设为 false 则自动继续，不等待审核
# REQUIREMENT_REVIEW_GATE=false
